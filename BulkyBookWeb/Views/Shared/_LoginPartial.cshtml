@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager


@if (SignInManager.IsSignedIn(User))
{
    <a class="text-white-50 text-decoration-none small fw-medium">
       <i class="bi bi-person-circle me-1"></i> @UserManager.GetUserName(User)
    </a>
    <form method="post" asp-area="Identity" asp-controller="Account" asp-action="Logout">
        <button type="submit" class="btn btn-link text-white-50 text-decoration-none small nav-link-hover">Logout</button>
    </form>
} else {

<a class="text-white-50 text-decoration-none small nav-link-hover" asp-area="Identity" asp-controller="Account" asp-action="Register">Register</a>
<a class="btn btn-sm btn-accent fm-semibold" asp-area="Identity" asp-controller="Account" asp-action="Login">Login</a>
}
